{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/minimax-m3",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/minimax-m3",
      "temperature": 0.1,
      "steps": 40,
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git status *": "allow",
          "git diff *": "allow",
          "grep *": "allow",
          "ls *": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout": "allow",
          "general": "allow",
          "review": "allow",
          "design-fallback": "allow"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/kimi-k3",
      "temperature": 0.2,
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    // System agent. Built-in, primary, and hidden from the UI. Its purpose is only to keep non-visible consumption on the lowest-cost model. The hidden flag is not used here because it is only for mode: subagent.
    "title": {
      "mode": "primary",
      "model": "opencode-go/mimo-v2.6-flash"
    },
    "summary": {
      "mode": "primary",
      "model": "opencode-go/mimo-v2.6-flash"
    },
    "compaction": {
      "mode": "primary",
      "model": "opencode-go/mimo-v2.6-flash"
    }
  }
}
